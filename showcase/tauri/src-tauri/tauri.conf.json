{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hydra",
  "version": "1.0.0",
  "identifier": "com.easonjiang.hydra",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "createUpdaterArtifacts": false,
    "externalBin": [
      "binaries/roamies-node"
    ],
    "copyright": "Hydra Desktop is a modified version of Roamies by Ken Kai (AGPL-3.0)"
  },
  "plugins": {}
}
